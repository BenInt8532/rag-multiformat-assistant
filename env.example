# Настройки RAG-ассистента
# Скопируйте этот файл в .env (в этой же папке) и впишите свои значения

# ---------- Ключ ----------
# Ключ OpenAI: используется и для ответов, и для эмбеддингов (обязательно)
OPENAI_API_KEY=your_openai_api_key_here

# ---------- Модели ----------
# Опционально: модель для генерации ответов (по умолчанию gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Опционально: модель эмбеддингов (по умолчанию text-embedding-3-small).
# При смене модели база соберётся заново в отдельной коллекции
# EMBEDDING_MODEL=text-embedding-3-small

# Опционально: температура генерации (по умолчанию 0.3)
# TEMPERATURE=0.3

# ---------- Поиск ----------
# Опционально: потолок числа чанков, которые передаются модели (по умолчанию 8)
# TOP_K=8

# Опционально: бюджет контекста в символах (по умолчанию 2000). Лучшие чанки набираются,
# пока помещаются в бюджет: мелких чанков войдёт больше, крупных меньше.
# Число чанков не превысит TOP_K.
# CONTEXT_BUDGET=2000

# Опционально: порог схожести от 0 до 1. Чанки со схожестью ниже порога не берутся;
# если не прошёл ни один, ассистент отвечает, что в документах этого нет, и модель не вызывается.
# Не задано - порога нет
# SCORE_THRESHOLD=0.2

# ---------- Подготовка документов ----------
# Опционально: как резать документы на чанки
# rules - каждому файлу своё правило из chunking.txt (по умолчанию)
# uniform - одно правило на все файлы (правило "uniform" из chunking.txt)
# CHUNKING_MODE=rules

# Опционально: очищать ли текст перед нарезкой (по умолчанию 1)
# 1 - убирать меню, шапку и подвал страниц, колонтитулы и переносы PDF, лишние пробелы
# 0 - брать текст как есть
# CLEAN_TEXT=1

# ---------- Оценка RAGAS (evaluate_ragas.py) ----------
# Опционально: откуда брать эталонный ответ (ground truth)
# real - из файла eval/questions.json (по умолчанию)
# answer - первые 100 символов ответа самой модели
# GROUND_TRUTH_MODE=real
