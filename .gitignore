# Ключи и настройки: .env и любые его копии (.env copy, .env.local)
.env*

# Виртуальные окружения (рабочее и пробное на другой версии Python)
.venv*/

# Векторная база и кеш ответов (создаются при запуске)
chroma_db/
*.db

# Результаты и логи прогонов (создаются скриптами проверки)
results/

# Служебные файлы Python
__pycache__/
*.pyc
